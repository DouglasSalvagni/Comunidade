# Configurações do Servidor
NODE_ENV=development
APP_NAME=Ninaro
API_DESCRIPTION=API da plataforma de conteúdo infantil
PORT=3003

# White Label — Identidade da Plataforma
APP_LOGO_URL=https://cdn.example.com/logo.png
APP_PRIMARY_COLOR=#4A90E2
APP_SUPPORT_URL=https://ajuda.example.com

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_tales

# Redis
REDIS_URL=redis://localhost:6379

# URLs
BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
GOOGLE_CLIENT_ID=your-google-client-id

# APPLE
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_ID_IOS=your-apple-client-id-ios
APPLE_CLIENT_ID_WEB=your-apple-client-id-web
APPLE_CLIENT_IDS=your-apple-client-id-ios,your-apple-client-id-web

# CORS
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_ANTI_ABUSE_ENABLED=false

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Payment Gateway (opcional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ASAAS (Payment Gateway)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=your-asaas-api-key

# Monitoring (opcional)
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
