# Configurações do Servidor
NODE_ENV=development
APP_NAME=Ninaro
PORT=3003

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_tales

# Redis
REDIS_URL=redis://localhost:6379

# URLs
BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
GOOGLE_CLIENT_ID=your-google-client-id

# APPLE
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_ID_IOS=your-apple-client-id-ios
APPLE_CLIENT_ID_WEB=your-apple-client-id-web
APPLE_CLIENT_IDS=your-apple-client-id-ios,your-apple-client-id-web

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS S3 ou S3-Compatible Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
CDN_BASE_URL=https://your-cdn-url.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE=104857600 # 100MB
UPLOAD_DEST=./uploads

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Payment Gateway (opcional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ASAAS (Payment Gateway)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=your-asaas-api-key

# Monitoring (opcional)
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
