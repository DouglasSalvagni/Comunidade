# ─── Core ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3003/api/v1
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# ─── White Label — Identidade ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Comunidade
NEXT_PUBLIC_APP_DESCRIPTION=Sua plataforma de conteúdo digital
NEXT_PUBLIC_APP_LOCALE=pt-BR
NEXT_PUBLIC_LOGO_URL=https://cdn.example.com/logo.png
NEXT_PUBLIC_FAVICON_URL=https://cdn.example.com/favicon.ico
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@example.com

# ─── White Label — Cores ───────────────────────────────────────────────────
# Valores em hex. Aplicados via <style> inline no servidor — zero flash.
# O env é a fonte única de cores; não há fallback ou sobrescrita pelo banco.
# ⚠️  Requer reinício do servidor (npm run dev) após qualquer alteração.
NEXT_PUBLIC_PRIMARY_COLOR='#7C3AED'
NEXT_PUBLIC_SECONDARY_COLOR='#061769'
NEXT_PUBLIC_ACCENT_COLOR='#FBBF24'
NEXT_PUBLIC_SIDEBAR_BG_COLOR='#1E1B4B'

# ─── Auth Social ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# ─── Imagens e Upload ──────────────────────────────────────────────────────
NEXT_PUBLIC_MAX_FILE_SIZE=104857600
NEXT_PUBLIC_DEFAULT_AVATAR=https://via.placeholder.com/150
NEXT_PUBLIC_DEFAULT_COVER=https://via.placeholder.com/300x400

# ─── Cache ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CACHE_TTL=300

# ─── Features Opcionais ────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_MEMBERS_DRAWER=true
