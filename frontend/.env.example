# Configurações do Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:3003/api/v1
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ninaro
NEXT_PUBLIC_APP_DESCRIPTION=Músicas e Audiobooks Infantis

# google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Configurações de Upload
NEXT_PUBLIC_MAX_FILE_SIZE=104857600 # 100MB

# URLs de Imagens
NEXT_PUBLIC_DEFAULT_AVATAR=https://via.placeholder.com/150
NEXT_PUBLIC_DEFAULT_COVER=https://via.placeholder.com/300x400

# Configurações de Cache
NEXT_PUBLIC_CACHE_TTL=300 # 5 minutos

# Modo de Desenvolvimento
NODE_ENV=development
