{
  "expo": {
    "name": "Ninaro",
    "slug": "ninaro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.wizer.ninaro",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1023"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio",
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.wizer.ninaro.ios"
    },
    "android": {
      "package": "com.wizer.ninaro.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1023"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://api.ninaro.com.br/api/v1",
      "siteBaseUrl": "http://ninaro.com.br",
      "googleOAuth": {
        "expoClientId": "138589572018-4htk4o9k84oembmlhq91acib0tnkstcp.apps.googleusercontent.com",
        "iosClientId": "138589572018-i2g3msa0sfilot9c22d3m3qdcdmb7n41.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "480e540c-b41d-4cbf-9896-efb3a5b34755"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.138589572018-i2g3msa0sfilot9c22d3m3qdcdmb7n41"
        }
      ]
    ],
    "owner": "douglassalvagni"
  }
}
