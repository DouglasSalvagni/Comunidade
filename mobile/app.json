{
  "expo": {
    "name": "Ninaro",
    "slug": "ninaro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.wizer.ninaro",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1023"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.wizer.ninaro.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1023"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://api.ninaro/api/v1",
      "googleOAuth": {
        "expoClientId": "138589572018-68n1bddpfb6rb7v26affl73ve50rl9qj.apps.googleusercontent.com",
        "androidClientId": "138589572018-kng4c67j63jbsv2uga5kl7mqj7pm3jmg.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "ae27d378-c772-4518-8bb5-8fe917771767"
      }
    },
    "plugins": [
      "expo-web-browser"
    ],
    "owner": "wizerdigital"
  }
}
