{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "production-ios": {
      "autoIncrement": true,
      "channel": "production-ios",
      "ios": {}
    },
    "production-android": {
      "autoIncrement": true,
      "channel": "production-android",
      "android": {}
    }
  },
  "submit": {
    "production": {},
    "production-ios": {}
  }
}